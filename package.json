{
  "name": "telegram-mining-clicker",
  "version": "1.0.0",
  "description": "Telegram Mini App Mining Game",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/check-build.cjs",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:visual": "node scripts/visual-arena.cjs",
    "shots": "node scripts/render-scenes.cjs",
    "test:coach": "node scripts/test-coach-browser.cjs",
    "test:browser": "node scripts/test-platform-browser.cjs",
    "test:clicker": "node scripts/test-clicker-browser.cjs",
    "test:deepdive": "node scripts/test-deepdive-browser.cjs",
    "test:bosses": "node scripts/test-bosses-browser.cjs",
    "test:guide": "node scripts/test-guide-browser.cjs",
    "test:classic": "node scripts/test-classic-browser.cjs",
    "test:quests": "node scripts/test-quests-browser.cjs",
    "test:prestige": "node scripts/test-prestige-browser.cjs",
    "test:touch": "node scripts/test-platform-touch.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.23.1",
    "telegraf": "^4.16.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "playwright-core": "^1.64.1"
  }
}
