# انسخ هذا الملف إلى .env وضع القيم الحقيقية
# توكن البوت من @BotFather (اختياري — بدونه يعمل خادم الويب فقط)
BOT_TOKEN=
# الرابط العام للعبة بعد الاستضافة أو عبر ngrok (يُستخدم في زر فتح اللعبة)
APP_URL=https://your-domain.com
PORT=3000
# قاعدة البيانات: SQLite افتراضياً في data/game.db — أو PostgreSQL:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_FILE=data/game.db
# MAX_CLICKS_PER_SEC=20
# وضع الضيف (حفظ على الخادم بدون تيليجرام): يعمل تلقائياً عند غياب BOT_TOKEN.
# فعّله مع وجود توكن فقط أثناء التطوير المحلي — لا تفعّله في الإنتاج:
# ALLOW_GUEST_AUTH=true
