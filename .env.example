# ============================================================
# انسخ هذا الملف إلى .env وضع القيم الحقيقية — لا ترفع .env أبداً إلى Git
# ============================================================

# --- تيليجرام (مطلوب للإنتاج، اختياري للتجربة المحلية) ---
# توكن البوت من @BotFather
BOT_TOKEN=
# الرابط العام للعبة بعد الاستضافة (https://اسم-خدمتك.onrender.com)
# يُستخدم في زر "فتح اللعبة" داخل البوت. بعد أول نشر على Render ضع رابطه هنا وأعد النشر.
APP_URL=https://your-domain.com

# --- الخادم ---
# محلياً 3000 — على Render يُضبط تلقائياً من المنصة ولا حاجة لتعيينه
PORT=3000

# --- قاعدة البيانات ---
# الافتراضي: SQLite محلي في data/game.db (لا تضبط شيئاً)
# للإنتاج: رابط PostgreSQL (Supabase/Neon/Render) — عند وجوده تُستخدم PostgreSQL تلقائياً
# مثال Supabase: استخدم رابط "Session pooler" من لوحة Supabase > Project Settings > Database
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_FILE=data/game.db
# PGSSL=disable        # فقط إذا رفض مزود القاعدة اتصال SSL

# --- مكافحة الغش ---
# أقصى نقرات/ثانية تُحتسب في سقف الكسب المسموح خادمياً
# MAX_CLICKS_PER_SEC=20

# --- السباقات المباشرة (اختياري) ---
# مدة السباق بالثواني يقررها الخادم ويبلّغها للعميل (2–300)، وسماح الشبكة بعدها قبل أن يختم الخادم النتيجة (1–60)
# RACE_DURATION_SEC=60
# RACE_GRACE_SEC=8

# --- وضع الضيف (حفظ بلا تيليجرام) ---
# يعمل تلقائياً محلياً عند غياب BOT_TOKEN. لا تفعّله أبداً في الإنتاج:
# ALLOW_GUEST_AUTH=true
